# ─────────────────────────────────────────────────────────────────────────────
# Fluxentiq — environment template.
#
#   • Local development   → copy to `.env.local`  (loaded by Next.js + the
#                           Python bridge's python-dotenv).
#   • Docker deployment   → copy to `.env`       (loaded by docker-compose.yml).
#
# Fill in the values below. Never commit a populated env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider (bring-any-key) ─────────────────────────────────────────────
# Choose ONE provider. All are supported by the Python bridge.
#   openai | groq | gemini | anthropic | custom (OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional: override the provider's default model.
#LLM_MODEL=
# Required ONLY for LLM_PROVIDER=custom (or to override a vendor's base URL).
#LLM_BASE_URL=
# Optional AI budget/fallback/rate-limit controls (defaults are safe bounded values).
#AI_DEFAULT_TOKEN_CAP=10000000
#AI_DEFAULT_COST_CAP_USD=500
#AI_FALLBACK_PROVIDER=groq
#AI_FALLBACK_MODEL=llama-3.1-8b-instant
#AI_RATE_LIMIT=60
#AI_RATE_WINDOW_MS=60000

# Groq (backward-compatible aliases — used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Python AI bridge
AI_BRIDGE_URL=http://localhost:8000
AI_BRIDGE_PORT=8000
AI_BRIDGE_CORS_ORIGINS=http://localhost:3000
# Shared secret authenticating Next.js → bridge requests. Required: the bridge
# fails closed (401) on /api/* when unset. Generate with `openssl rand -hex 32`.
BRIDGE_SECRET_KEY=
# Comma-separated host allow-list for the bridge's web scraper (SSRF guard).
# e.g. `example.com,linkedin.com` — leave empty to disable scraping entirely.
PYTHON_BRIDGE_ALLOWED_SCRAPE_HOSTS=

# Supabase (canonical source of truth)
# ── New Publishable / Secret API keys (recommended) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
# Optional direct PostgreSQL URL for schema/migration verification only.
# DATABASE_URL=
# POSTGRES_URL=

# ── Legacy JWT keys (deprecated — kept only as fallback aliases) ────────────
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Webhook / cron secrets (required — fail-closed when unset) ──────────────
# CRON_SECRET: guards /api/system/cron. Without it the endpoint is DISABLED.
CRON_SECRET=
# N8N_WEBHOOK_URL: optional outbound n8n workflow endpoint.
N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET: HMAC secret for inbound n8n workflow triggers.
N8N_WEBHOOK_SECRET=
# Tenant-scoped SCIM token; prefer SCIM_TOKEN_<TENANT_ID> in deployment secrets.
SCIM_BEARER_TOKEN=
# PYTHON_BRIDGE_WEBHOOK_SECRET: HMAC secret for bridge→app webhooks.
PYTHON_BRIDGE_WEBHOOK_SECRET=

# ── Self-hosted PostgreSQL (Docker Compose `db` service) — optional ─────────
# Only needed when using the bundled PostgreSQL as the "memory" backend.
# Defaults are applied by docker-compose.yml when unset.
POSTGRES_USER=fluxentiq
POSTGRES_PASSWORD=
POSTGRES_DB=fluxentiq

# ── Phase R: production pilot controls (all read at request time) ─────────
# Disable every AI/agent endpoint immediately (503 AI_DISABLED). Reversible.
AI_KILL_SWITCH=0
# Comma-separated organisation UUIDs allowed to use AI during the pilot.
# Empty in production → AI endpoints return 503 until configured.
PILOT_ORG_ALLOWLIST=
PILOT_MAX_REQUEST_TOKENS=12000
PILOT_MAX_TOOL_ROUNDS=3
# Identity reported by /api/health, /api/system/ready and telemetry.
APP_ENV=development
APP_BUILD_ID=

# Storage (private bucket only; keys are tenant-prefixed and signed).
STORAGE_PROVIDER=          # supabase | local (dev only) | empty = disabled
STORAGE_BUCKET=documents
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNING_SECRET=    # required for STORAGE_PROVIDER=local
# Malware scanning — uploads are REFUSED when the scanner is unset/unreachable.
MALWARE_SCANNER=           # clamav-rest | webhook | disabled
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=15000

# Email delivery (console is development-only; production must use a relay)
EMAIL_PROVIDER=            # console | http | smtp
EMAIL_HTTP_URL=

# Public application URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Edge Shield rate limits (requests/minute; defaults are deliberately conservative).
# For isolated E2E/dev servers, override the limits in the test process only.
EDGE_AUTH_RATE_LIMIT=10
EDGE_WEBHOOK_RATE_LIMIT=10

# Observability
METRICS_BACKEND=           # prometheus | otlp | empty (in-memory only)
METRICS_TOKEN=             # bearer token protecting GET /api/metrics
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_TRACKING_DSN=        # Sentry-compatible DSN (never commit)
ERROR_TRACKING_WEBHOOK=    # alternative JSON webhook sink
